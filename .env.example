# Podcast Directory Manager - Environment Configuration
# Copy this file to .env and update with your production values

# Application Settings
APP_NAME="Podcast Directory Manager"
APP_VERSION="1.0.0"
APP_URL="https://yourdomain.com"
ENVIRONMENT="production"

# Security
# Generate a secure random string for session security
SESSION_SECRET="your-random-secret-key-here"

# File Upload Settings
MAX_FILE_SIZE=2097152
MIN_IMAGE_WIDTH=1400
MIN_IMAGE_HEIGHT=1400
MAX_IMAGE_WIDTH=3000
MAX_IMAGE_HEIGHT=3000

# Timezone
TIMEZONE="UTC"

# Admin Authentication  -- ACTIVE, read by includes/Auth.php
#
# The admin password, in plain text. Set it in the Coolify dashboard:
#   Configuration -> Environment Variables -> Add
#   Name: ADMIN_PASSWORD   Value: whatever you want the password to be
#
# To change the password later, edit that value and redeploy. There is
# deliberately no password-change screen in the app.
#
# Leading/trailing whitespace is stripped. If this is unset or blank, Auth.php
# falls back to the old auth.js password ('podcast2025') so a missing env var
# cannot lock you out. The login page shows which one is in use.
# See docs/HANDOFF.md.
ADMIN_PASSWORD=""

# Error Reporting (set to 0 in production)
ERROR_REPORTING=0
DISPLAY_ERRORS=0

# Backup Settings
MAX_BACKUPS=10
BACKUP_RETENTION_DAYS=30
